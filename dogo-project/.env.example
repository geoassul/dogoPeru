# Variables de entorno para DoGo Store
# Copiar este archivo a .env (está en .gitignore) y completar los valores.
# La aplicación lo lee sola al arrancar desde la raíz del proyecto (spring.config.import);
# las variables de entorno del sistema tienen prioridad.

# Base de datos
DB_USERNAME=root
DB_PASSWORD=your_db_password
# DB_URL=jdbc:mysql://localhost:3306/tienda_ropa_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# JWT (OBLIGATORIO): Base64 de al menos 32 bytes. Generar con:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400000

# Esquema: none (por defecto) | validate | update
# DDL_AUTO=none

# CORS de la API privada (opcional): por defecto localhost y la red local 192.168.*.*
# La web pública (/api/public/**) funciona desde cualquier dominio sin configurar nada.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://192.168.*.*:8080

# Servidor y uploads (opcionales)
# SERVER_PORT=8080
# UPLOAD_DIR=C:/dogo-uploads
# UPLOAD_MAX_SIZE=10485760
